{
  "name": "3dts-project-manager",
  "version": "1.0.0",
  "private": true,
  "description": "3D Technology Services - online Project Manager (Cloudflare Pages Functions + D1)",
  "scripts": {
    "dev": "wrangler pages dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler pages deploy",
    "db:create": "wrangler d1 create pm-db",
    "db:migrate:local": "wrangler d1 migrations apply pm-db --local",
    "db:migrate": "wrangler d1 migrations apply pm-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "unpdf": "^0.12.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.80.0"
  }
}
